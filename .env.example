# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# Phase 1 coding inference (Plandex -> Headroom -> request contract -> Spark).
# SPARK_BASE_URL must include the OpenAI-compatible /v1 suffix. The model ID
# is intentionally deployment-supplied until it has been discovered from the
# remote endpoint. SPARK_API_TOKEN is accepted as a temporary secret alias by
# the integration scripts; prefer SPARK_API_KEY for new deployments.
SPARK_BASE_URL='https://leon4gr45-llama.hf.space/v1'
SPARK_MODEL='spark-x2.5-1.7b'
SPARK_API_KEY=''
# SPARK_API_TOKEN=''
SPARK_CONTEXT_LIMIT='32768'
SPARK_MAX_INPUT_TOKENS='24576'
SPARK_MAX_OUTPUT_TOKENS='4096'
SPARK_CONTEXT_RESERVE='4096'
SPARK_TEMPERATURE='0.2'
SPARK_TOP_P='0.95'
SPARK_CONNECT_TIMEOUT='15'
SPARK_READ_TIMEOUT='300'
SPARK_MAX_RETRIES='1'
SPARK_CONTRACT_HOST='127.0.0.1'
SPARK_CONTRACT_PORT='8790'
HEADROOM_BASE_URL='http://127.0.0.1:8787/v1'
HEADROOM_HOST='127.0.0.1'
HEADROOM_PORT='8787'

# Phase 2 local tool selection. Stock Needle3 uses deployment-baked artifacts
# in the cactus-needle cache and MUST remain empty here. Set only for a future
# custom/fine-tuned archive, which intentionally uses Needle's worker path.
NEEDLE_CUSTOM_WEIGHTS=''
NEEDLE_MODEL_REPO='Cactus-Compute/needle3'
NEEDLE_MODEL_REVISION='0f51a1ac2917a03644c4cc7836f19476c6d177dd'
NEEDLE_MODEL_FILE='needle3.cact'
NEEDLE_MODEL_SHA256='c9d915eca282ed42d1a09b143b592adb4cc6744ffe2d294adf5cfc5548170c38'
NEEDLE_ENGINE_FILE='python/cactus_needle-3.0.1-py3-none-manylinux2014_x86_64.whl'
NEEDLE_ENGINE_WHEEL_SHA256='05770ef9a85686583968ea15f62f9ad44217e078efdaa99559d3208bb8a369b0'
# Optional diagnostic pin for the extracted needle/libneedle3.so.
NEEDLE_ENGINE_LIBRARY_SHA256=''
NEEDLE_CONFIDENCE_THRESHOLD='0.70'
NEEDLE_CONFIRM_THRESHOLD='0.30'
NEEDLE_MAX_CANDIDATES='5'
NEEDLE_MAX_NEW_TOKENS='512'
NEEDLE_ALLOWED_EFFECTS='read'
NEEDLE_TELEMETRY='0'

# Phase 3 GitHub-first control plane. GITHUB_PAT is canonical; aliases are
# generated only for the pinned, read-only GitHub MCP subprocess.
GITHUB_PAT=''
ALLOWED_GITHUB_REPOS=''
ALLOWED_GITHUB_ORGS=''
CONTROL_PLANE_DATA_DIR='./data/control-plane'
# Phase 4 local structural repository graph. Indexes are stored beneath
# $CONTROL_PLANE_DATA_DIR/graphs and code-only extraction never uses an LLM.
GRAPHIFY_EXECUTABLE='graphify'
GRAPHIFY_INDEX_TIMEOUT='300'
# Phase 4B bounded structural briefing. These are calibration parameters, not
# Graphify/model limits. Briefings must satisfy both byte and token estimates.
GRAPH_CONTEXT_MAX_QUERIES='3'
GRAPH_CONTEXT_MAX_NODES='20'
GRAPH_CONTEXT_MAX_RELATIONSHIPS='40'
GRAPH_CONTEXT_MAX_FILES='10'
GRAPH_CONTEXT_MAX_HOPS='2'
GRAPH_CONTEXT_MAX_BYTES='12288'
GRAPH_CONTEXT_MAX_ESTIMATED_TOKENS='2500'
PLANDEX_API_HOST='http://127.0.0.1:8099'
PLANDEX_CLI_HOME='/var/lib/plandex-cli'
PLANDEX_BASE_DIR='/var/lib/plandex-server'
PLANDEX_SERVER_HOST='127.0.0.1'
PLANDEX_SERVER_PORT='8099'
# Must point to a dedicated Plandex PostgreSQL database, not control_plane.
# PLANDEX_DATABASE_URL='postgresql://plandex:<secret>@127.0.0.1:5432/plandex?sslmode=disable'

# Plandex's verified, build-time-populated tiktoken-go cache. Immutable URL,
# SHA256, and cache key are locked in third_party/versions.lock; only the cache
# location is runtime configuration. TIKTOKEN_O200K_FETCH_URL is build-only and
# may point at a mirror whose bytes still pass the canonical SHA256 check.
TIKTOKEN_CACHE_DIR='/opt/integration/tiktoken-cache'
# Build-only override. The default is the immutable mirror recorded in
# third_party/versions.lock; overriding transport never changes hash identity.
# TIKTOKEN_O200K_FETCH_URL=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to true to add compact row/column stats to parsed CSV retrieval context.
ENABLE_RAG_CSV_SUMMARY=false

# Set to true to preserve backing file records, storage blobs, and per-file vectors when files are removed from knowledge bases.
ENABLE_KNOWLEDGE_FILE_RETENTION=false

# Comma-separated chunk metadata keys to expose to the model alongside retrieved content.
RAG_SOURCE_METADATA_KEYS=''

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK='1'
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
